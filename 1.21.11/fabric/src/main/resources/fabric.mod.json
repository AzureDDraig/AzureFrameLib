{
  "schemaVersion": 1,
  "id": "azureframelib",
  "version": "${version}",
  "name": "AzureFrameLib",
  "description": "Shared library and dynamic resource framework for Minecraft mods.",
  "authors": [
    "Azureddraig"
  ],
  "contact": {
    "sources": "https://github.com/AzureDDraig/AzureFrameLib"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ddraig.net.azureframelib.fabric.AzureFrameLibFabric"
    ],
    "client": [
      "ddraig.net.azureframelib.fabric.client.AzureFrameLibFabricClient"
    ]
  },
  "mixins": [
    "azureframelib.mixins.json",
    "azureframelib.geckolib.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "architectury": ">=19.0.1",
    "fabric-api": "*"
  }
}